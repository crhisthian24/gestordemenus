{% extends 'base.html.twig' %}
{% block title %}Editar — {{ empresa.nombre }}{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('app_empresa_index') }}">Empresas</a>
    <span class="sep"><i class="ti ti-chevron-right"></i></span>
    <span class="current">Editar — {{ empresa.nombre }}</span>
{% endblock %}
{% block body %}
<div class="page-header">
    <div>
        <div class="page-title"><i class="ti ti-edit"></i> Editar empresa</div>
        <div class="page-sub">{{ empresa.nombre }}</div>
    </div>
</div>
<div class="card" style="padding:24px">
    {{ form_start(form, {attr: {novalidate: true}}) }}
        {% include 'empresa/_form.html.twig' %}
    {{ form_end(form) }}
</div>
{% endblock %}