    <span class="sep"><i class="ti ti-chevron-right"></i></span>
    <span class="current">Nueva empresa</span>
{% endblock %}
{% block body %}
<div class="page-header">
    <div>
        <div class="page-title"><i class="ti ti-plus"></i> Nueva empresa</div>
        <div class="page-sub">Configura la conexión SFTP</div>
