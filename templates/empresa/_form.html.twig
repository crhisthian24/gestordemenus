<div class="form-section">
    <div class="form-section-title"><i class="ti ti-building-factory-2"></i> Datos de la empresa</div>
    <div class="form-group">
        {{ form_label(form.nombre, 'Nombre', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.nombre, {attr: {class: 'form-control', placeholder: 'Nombre de la empresa'}}) }}
        {{ form_errors(form.nombre) }}
    </div>
    <div class="form-group">
        {{ form_label(form.activo, 'Activo', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.activo) }}
    </div>
</div>
<div class="form-section">
    <div class="form-section-title"><i class="ti ti-server"></i> Conexión SFTP</div>
    <div class="form-row">
        <div class="form-group">
            {{ form_label(form.host, 'Host', {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.host, {attr: {class: 'form-control', placeholder: 'sftp.empresa.com'}}) }}
            {{ form_errors(form.host) }}
        </div>
        <div class="form-group">
            {{ form_label(form.puerto, 'Puerto', {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.puerto, {attr: {class: 'form-control'}}) }}
            {{ form_errors(form.puerto) }}
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            {{ form_label(form.usuario, 'Usuario', {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.usuario, {attr: {class: 'form-control', placeholder: 'usuario_sftp', autocomplete: 'off'}}) }}
            {{ form_errors(form.usuario) }}
        </div>
        <div class="form-group">
            {{ form_label(form.password, 'Contraseña SFTP', {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.password, {attr: {class: 'form-control', autocomplete: 'new-password'}}) }}
            {{ form_errors(form.password) }}
            <div class="form-hint"><i class="ti ti-lock"></i> Se almacenará cifrada con AES-256</div>
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.rutaRemota, 'Ruta remota', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.rutaRemota, {attr: {class: 'form-control', placeholder: '/home/empresa/documentos'}}) }}
        {{ form_errors(form.rutaRemota) }}
    </div>
</div>
<div class="form-actions">
    <a href="{{ path('app_empresa_index') }}" class="btn btn-outline"><i class="ti ti-arrow-left"></i> Cancelar</a>
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Guardar</button>
</div>